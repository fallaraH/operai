# Copie para .env.local. Tudo aqui é opcional: sem chave, o /api/parse usa só
# o interpretador local em português (funciona offline).

# Chave da API da Anthropic para o modo IA (consultado quando o local tem dúvida).
ANTHROPIC_API_KEY=

# "ligada" tenta a IA com outras credenciais do SDK (ex.: `ant auth login`);
# "desligada" força só o interpretador local.
# OPERAI_IA=

# Modelo do modo IA (padrão: claude-opus-5-5).
# OPERAI_IA_MODELO=claude-opus-5-5
